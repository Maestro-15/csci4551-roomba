digraph G {
rankdir=LR; graph [fontname="Helvetica", nodesep=0.28, ranksep=0.9, pad=0.3];
node [fontname="Helvetica", fontsize=12]; edge [color="#555555", arrowsize=0.7];
"T/cmd_vel" [label="/cmd_vel", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/stop_before_hit" -> "T/cmd_vel";
"/rosbot_gz_bridge" -> "T/cmd_vel";
"/joy2twist" -> "T/cmd_vel";
"T/cmd_vel" -> "/mecanum_drive_controller";
"T/imu/data" [label="/imu/data", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/imu_broadcaster" -> "T/imu/data";
"T/imu/data" -> "/ekf_node";
"T/joint_states" [label="/joint_states", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/joint_state_broadcaster" -> "T/joint_states";
"T/joint_states" -> "/robot_state_publisher";
"T/joy" [label="/joy", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/joy" -> "T/joy";
"T/joy" -> "/joy2twist";
"T/oak/rgb/color" [label="/oak/rgb/color", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/oak_CAM11_gz_bridge" -> "T/oak/rgb/color";
"T/oak/rgb/color" -> "/sensor_rviz";
"T/oak/stereo/depth" [label="/oak/stereo/depth", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/oak_CAM11_gz_bridge" -> "T/oak/stereo/depth";
"T/oak/stereo/depth" -> "/sensor_rviz";
"T/odometry/wheels" [label="/odometry/wheels", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/mecanum_drive_controller" -> "T/odometry/wheels";
"T/odometry/wheels" -> "/ekf_node";
"T/scan" [label="/scan", shape=box, style="filled", fillcolor="#FFF3C4", color="#B58900"];
"/LDR06_gz_bridge" -> "T/scan";
"T/scan" -> "/sensor_rviz";
"T/scan" -> "/stop_before_hit";
"/LDR06_gz_bridge" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/ekf_node" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/imu_broadcaster" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/joint_state_broadcaster" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/joy" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/joy2twist" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/mecanum_drive_controller" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/oak_CAM11_gz_bridge" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/robot_state_publisher" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/rosbot_gz_bridge" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/sensor_rviz" [shape=ellipse, style=filled, fillcolor="#CFE2F3", color="#3D6E9E"];
"/stop_before_hit" [shape=ellipse, style=filled, fillcolor="#9BE29B", color="#2E7D32"];
}