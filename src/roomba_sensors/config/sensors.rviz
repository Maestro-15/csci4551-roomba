      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Color camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /oak/rgb/color
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 5
      Median window: 5
      Min Value: 0
      Name: Depth camera
      Normalize Range: false
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /oak/stereo/depth
      Value: true
  Enabled: true
  Global Options:
    Background Color: 38; 38; 42
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
