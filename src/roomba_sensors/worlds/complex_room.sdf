<?xml version="1.0" ?>
<!-- 10 x 10 m room with mixed obstacles. The robot starts at the center, facing +x. Low ones (under 16 cm) are invisible to the LiDAR, and the table top is only visible to the camera. -->
<sdf version="1.9">
  <world name="complex_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 5.05 0.3000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.05 0.3000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>5.05 0 0.3000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 10.2 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 10.2 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5.05 0 0.3000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 10.2 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 10.2 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_long">
      <static>true</static>
      <pose>-2.6 2.0 0.3000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.0 0.1 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.0 0.1 0.6</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="inner_wall_short">
      <static>true</static>
      <pose>-1.15 3.0 0.3000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 2.0 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 2.0 0.6</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="gap_left">
      <static>true</static>
      <pose>3.2 -2.0 0.2500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 1.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 1.2 0.5</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="gap_right">
      <static>true</static>
      <pose>3.2 -3.9 0.2500 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 1.2 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 1.2 0.5</size></box></geometry>
          <material><ambient>0.55 0.35 0.2 1</ambient><diffuse>0.55 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_box">
      <static>true</static>
      <pose>2.6 0.7 0.2000 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="long_crate">
      <static>true</static>
      <pose>3.6 2.9 0.2500 0 0 0.5236</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.4 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.4 0.5</size></box></geometry>
          <material><ambient>0.3 0.3 0.75 1</ambient><diffuse>0.3 0.3 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="small_cube">
      <static>true</static>
      <pose>-0.4 -1.9 0.1250 0 0 0.7854</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 0.25 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 0.25 0.25</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="big_drum">
      <static>true</static>
      <pose>-3.2 -3.0 0.3000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.4</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="thin_pole">
      <static>true</static>
      <pose>1.7 -1.3 0.5000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.03</radius><length>1.0</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="bucket">
      <static>true</static>
      <pose>-2.0 -0.6 0.1500 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.15</radius><length>0.3</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.7 1</ambient><diffuse>0.2 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="ball">
      <static>true</static>
      <pose>0.6 2.9 0.2000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.2</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.2</radius></sphere></geometry>
          <material><ambient>0.8 0.2 0.8 1</ambient><diffuse>0.8 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="yellow_low_box">
      <static>true</static>
      <pose>2.0 2.0 0.0250 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.05</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="low_plank">
      <static>true</static>
      <pose>-2.3 -2.0 0.0500 0 0 -0.4363</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.3 0.1</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.8 0.3 0.1</size></box></geometry>
          <material><ambient>0.6 0.45 0.25 1</ambient><diffuse>0.6 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="flat_disc">
      <static>true</static>
      <pose>3.5 -0.6 0.0400 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.08</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.08</length></cylinder></geometry>
          <material><ambient>0.95 0.6 0.6 1</ambient><diffuse>0.95 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="door_stop">
      <static>true</static>
      <pose>-0.6 -3.3 0.0300 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.15 0.06</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.3 0.15 0.06</size></box></geometry>
          <material><ambient>0.4 0.8 0.3 1</ambient><diffuse>0.4 0.8 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="small_ball">
      <static>true</static>
      <pose>-3.6 0.6 0.1000 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><sphere><radius>0.1</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><ambient>1.0 0.95 0.2 1</ambient><diffuse>1.0 0.95 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="lying_pipe">
      <static>true</static>
      <pose>0.9 -3.6 0.0700 0 1.5708 1.2217</pose>
      <link name="link">
        <collision name="collision"><geometry><capsule><radius>0.07</radius><length>0.8</length></capsule></geometry></collision>
        <visual name="visual"><geometry><capsule><radius>0.07</radius><length>0.8</length></capsule></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table_top">
      <static>true</static>
      <pose>-3.5 3.9 0.2800 0 0 0.0000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.6 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.6 0.04</size></box></geometry>
          <material><ambient>0.45 0.3 0.2 1</ambient><diffuse>0.45 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table_leg_0">
      <static>true</static>
      <pose>-3.05 4.15 0.1300 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table_leg_1">
      <static>true</static>
      <pose>-3.05 3.65 0.1300 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table_leg_2">
      <static>true</static>
      <pose>-3.95 4.15 0.1300 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table_leg_3">
      <static>true</static>
      <pose>-3.95 3.65 0.1300 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.025</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.3 0.2 0.1 1</ambient><diffuse>0.3 0.2 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
