<?xml version="1.0" ?>
<!-- Simple 6 x 6 m room. The robot starts at the center, facing +x (toward the red box). -->
<sdf version="1.9">
  <world name="obstacle_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.85 0.88 0.92 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.55 0.5 0.45 1</ambient><diffuse>0.55 0.5 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0 3.05 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3.05 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6.2 0.1 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6.2 0.1 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3.05 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.2 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3.05 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 6.2 0.6</size></box></geometry>
          <material><ambient>0.75 0.75 0.78 1</ambient><diffuse>0.75 0.75 0.78 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="red_box">
      <static>true</static>
      <pose>1.6 0 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.5 0.5 0.4</size></box></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="blue_cylinder">
      <static>true</static>
      <pose>-1.5 1.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.15 0.35 0.85 1</ambient><diffuse>0.15 0.35 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="green_block">
      <static>true</static>
      <pose>0.2 -1.8 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.0 0.2 0.4</size></box></geometry>
          <material><ambient>0.15 0.65 0.25 1</ambient><diffuse>0.15 0.65 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="yellow_low_box">
      <static>true</static>
      <pose>1.5 1.7 0.035 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 0.07</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 0.07</size></box></geometry>
          <material><ambient>0.95 0.8 0.1 1</ambient><diffuse>0.95 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
